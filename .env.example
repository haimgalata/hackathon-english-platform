# =============================================================================
# SpeakTech — environment variables (copy to .env.local or .env)
# Only variables referenced in code are listed below.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (MongoDB Atlas)
# -----------------------------------------------------------------------------
# Connection string from Atlas → Connect → Drivers (include user/password).
# Required for: /api/students, /api/sessions, /api/sessions/[id], /api/chat
# (persistence), /api/test-db
MONGODB_URI=

# Database name on the cluster. Defaults to "speaktech" if omitted.
MONGODB_DB_NAME=speaktech

# -----------------------------------------------------------------------------
# AI providers
# -----------------------------------------------------------------------------
# Groq — chat JSON tutor (/api/chat). Create key: https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI — server TTS only (/api/tts). Not used by /api/chat.
# Optional unless you call POST /api/tts (e.g. future feature); omit if unused.
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# This app does NOT use Clerk, Supabase Auth, or JWT env vars.
# Students: username stored in Mongo via POST /api/students (no env secrets).
# Teacher UI: PIN below (hackathon-style gate only).

# -----------------------------------------------------------------------------
# Public client variables (NEXT_PUBLIC_* are embedded in the browser bundle)
# -----------------------------------------------------------------------------
# Teacher dashboard PIN (/teacher). Default "1234" if unset.
# Security: treat as obfuscation only—not a secret. Anyone can read built JS.
NEXT_PUBLIC_TEACHER_PIN=

# -----------------------------------------------------------------------------
# Optional / defaults
# -----------------------------------------------------------------------------
# (none beyond MONGODB_DB_NAME and NEXT_PUBLIC_TEACHER_PIN defaults above)
